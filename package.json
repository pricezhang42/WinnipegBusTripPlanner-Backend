{
  "name": "bustripplanner-backend",
  "version": "0.1.0",
  "description": "Backend proxy for the Winnipeg Bus Trip Planner mobile app. Hides upstream API keys, enriches trip plans with shelter info, and serves route polylines from the GTFS feed.",
  "license": "0BSD",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
