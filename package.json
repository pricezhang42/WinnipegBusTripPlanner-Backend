{
  "name": "bustripplanner-backend",
  "version": "0.1.0",
  "description": "Backend proxy for the Winnipeg Bus Trip Planner mobile app. Hides upstream API keys, enriches trip plans with shelter info, and serves route polylines from the GTFS feed.",
  "license": "0BSD",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "tsc",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "refresh:destinations": "node --import tsx scripts/refresh-reliability-destinations.mjs",
    "check:reliability": "node scripts/check-reliability.mjs",
    "reliability:store": "node --import tsx scripts/reliability-store.mjs",
    "reliability:store:test": "node --import tsx --test scripts/reliability-store.test.mjs",
    "check:saved-items": "node scripts/check-saved-items.mjs",
    "db": "node scripts/database/cli.mjs",
    "db:check": "node scripts/database/cli.mjs check",
    "db:manifest": "node scripts/database/cli.mjs manifest",
    "db:tools:test": "node --test scripts/database/*.test.mjs",
    "db:refresh": "node scripts/database/refresh.mjs",
    "db:refresh:sql:test": "node scripts/database/refresh-sql-check.mjs",
    "db:refresh:rehearse": "node scripts/database/refresh-rehearsal.mjs",
    "connections:test": "node --test scripts/connections.test.mjs",
    "deploy": "node scripts/run.mjs deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.6.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "pg": "8.23.1",
    "supabase": "2.121.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
