# Template: copy to .env.local only if it does not exist.
# Backend runtime and database tooling. Keep this file private (chmod 600).

# --- Default selections ---
# CLI --server and --database override these independently.
DEFAULT_SERVER=local
DEFAULT_DATABASE=qa1

# --- Shared server settings ---
# Named server settings below override these shared values.
PORT=8787
CORS_ORIGINS=
GTFS_REFRESH_HOURS=24

# --- Upstream API credentials ---
# Mapbox geocoding and Winnipeg Transit API credentials; backend only.
MAPBOX_TOKEN=
WT_API_KEY=

# --- Reliability store ---
# Defaults to reliability/reliability.sqlite; `node scripts/fetch-reliability-store.mjs`
# downloads the pinned build there. Deployed images have it at that path too.
# RELIABILITY_STORE_PATH=/absolute/path/reliability.sqlite

# --- Server / deployment: local ---
LOCAL_API_URL=http://localhost:18787
LOCAL_PORT=18787
LOCAL_CORS_ORIGINS=http://localhost:8081

# --- Server / deployment: production ---
PRODUCTION_FLY_APP=bustripplanner-backend
PRODUCTION_API_URL=https://bustripplanner-backend.fly.dev

# --- Server / deployment: qa1 ---
QA1_FLY_APP=
QA1_API_URL=

# --- Server / deployment: qa2 ---
QA2_FLY_APP=
QA2_API_URL=

# --- Database: production ---
# Register the project reference in supabase/environments.json.
PRODUCTION_SUPABASE_URL=https://rshgohxdntjglnqilyls.supabase.co
PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
PRODUCTION_DATABASE_URL=
PRODUCTION_DATABASE_CA_FILE=

# --- Database: qa1 ---
# Register the project reference in supabase/environments.json.
QA1_SUPABASE_URL=https://dvxkygiqnvvghkmqxhvk.supabase.co
QA1_SUPABASE_PUBLISHABLE_KEY=
QA1_SUPABASE_ADMIN_KEY=
QA1_DATABASE_URL=
QA1_DATABASE_CA_FILE=

# --- Database: qa2 ---
# Register the project reference in supabase/environments.json.
QA2_SUPABASE_URL=
QA2_SUPABASE_PUBLISHABLE_KEY=
QA2_SUPABASE_ADMIN_KEY=
QA2_DATABASE_URL=
QA2_DATABASE_CA_FILE=

# --- Database management tools ---
# Operator-only credentials/tool paths; never included in the frontend or API runtime.
SUPABASE_ACCESS_TOKEN=
DATABASE_PG_BIN=
