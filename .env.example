# Copy to .env.local (ignored, chmod 600). This is the only local config file.
DEFAULT_SERVER=local
DEFAULT_DATABASE=qa1

# Shared runtime defaults; server blocks below can override them.
PORT=8787

# Mapbox token used for geocoding autocomplete.
# Get one at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Winnipeg Transit Open Data API key.
# Register at https://api.winnipegtransit.com/home/users/new
WT_API_KEY=

# Hours between GTFS feed refreshes. The feed is updated daily, so 12-24 is fine.
GTFS_REFRESH_HOURS=24

# Optional allowlist for CORS (comma-separated). Leave empty to allow all.
CORS_ORIGINS=

# Optional historical artifact manifests (defaults are in data/).
# Install complete manifest + route shard sets, then restart the backend.
# Report categories use report-scheduled-visit-ratio-v1; keep matching manifests and shards.
# RELIABILITY_DATA_PATH=/absolute/path/reliability.json
# PASSUP_RISK_DATA_PATH=/absolute/path/passup-risk.json
# PASSUP_REPORT_DATA_PATH=/absolute/path/passup-report-counts.json

# Optional versioned variant-ID -> historical destination lookup (loaded at startup).
# Refresh in a dev checkout with npm run refresh:destinations, then restart/deploy.
# RELIABILITY_DESTINATIONS_PATH=/absolute/path/reliability-destinations.json


# Database blocks. Register references/kind in supabase/environments.json.
PRODUCTION_SUPABASE_URL=https://rshgohxdntjglnqilyls.supabase.co
PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
PRODUCTION_DATABASE_URL=
PRODUCTION_DATABASE_CA_FILE=
QA1_SUPABASE_URL=https://dvxkygiqnvvghkmqxhvk.supabase.co
QA1_SUPABASE_PUBLISHABLE_KEY=
QA1_SUPABASE_ADMIN_KEY=
QA1_DATABASE_URL=
QA1_DATABASE_CA_FILE=
QA2_SUPABASE_URL=
QA2_SUPABASE_PUBLISHABLE_KEY=
QA2_SUPABASE_ADMIN_KEY=
QA2_DATABASE_URL=
QA2_DATABASE_CA_FILE=

# Server/deployment blocks. Choose separately from --database.
LOCAL_PORT=18787
LOCAL_CORS_ORIGINS=http://localhost:8081
LOCAL_API_URL=http://localhost:18787
PRODUCTION_FLY_APP=bustripplanner-backend
PRODUCTION_API_URL=https://bustripplanner-backend.fly.dev
QA1_FLY_APP=
QA1_API_URL=
QA2_FLY_APP=
QA2_API_URL=
# Optional server-specific overrides, e.g. QA1_WT_API_KEY / QA1_MAPBOX_TOKEN.
# Shared runtime defaults belong above in this file; process environment overrides them.

# Operator tooling only; never delivered to backend runtime or frontend.
SUPABASE_ACCESS_TOKEN=
DATABASE_PG_BIN=
